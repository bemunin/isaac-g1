        quatd xformOp:orient = (0.9999999999959704, 0, 0, 0.000002838856976978195)
        double3 xformOp:translate = (-0.00009003054583445191, 0.0000010660644420568133, -0.7922728583216667)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

